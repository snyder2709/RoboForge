{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for RoboForge",
  "platforms": ["linux", "macOS", "windows", "iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "notification:default",
    "notification:allow-notify",
    "os:default",
    "os:allow-platform",
    "os:allow-arch",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-load"
  ]
}
