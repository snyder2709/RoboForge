#VRML_SIM R2023b utf8

WorldInfo {
  title "RoboForge Simulation"
  basicTimeStep 32
  coordinateSystem "NUE"
}

Viewpoint {
  orientation -0.3 0.9 0.3 1.2
  position 0 1.5 2.5
  followType "None"
}

TexturedBackground {
  texture "noon_building_overcast"
}

TexturedBackgroundLight {
  texture "noon_building_overcast"
}

DEF ARENA RectangleArena {
  translation 0 0 0
  floorSize 5 5
  floorTileSize 0.5 0.5
  wallHeight 0.1
}

DEF ROBOT Robot {
  translation 0 0.14 0
  rotation 0 1 0 0
  name "roboforge_robot"
  controller "roboforge_controller"
  supervisor TRUE
  children [
    # Скелет загружается через URDF-импорт:
    # Wizards → Import a URDF robot → humanoid_v1.urdf
  ]
}
